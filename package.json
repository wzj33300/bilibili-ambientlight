{
  "name": "bilibili-ambientlight",
  "version": "0.2.3",
  "description": "Bilibili ambient light, adapted from WesselKroos/youtube-ambilight",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wzj33300/bilibili-ambientlight.git"
  },
  "author": "Wessel Kroos",
  "contributors": [
    "wzj33300 (Bilibili port)"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/wzj33300/bilibili-ambientlight/issues"
  },
  "homepage": "https://github.com/wzj33300/bilibili-ambientlight#readme",
  "type": "module",
  "scripts": {
    "build:manifest": "node manifest-copy.js",
    "build:html": "copyfiles -u 1 src/options.html dist",
    "build:images": "copyfiles -u 2 src/images/* dist/images",
    "build:styles:content": "sass --no-source-map src/styles/content.scss dist/styles/content.css",
    "build:styles:live-chat": "sass --no-source-map src/styles/live-chat.scss dist/styles/live-chat.css",
    "build:styles:options": "copyfiles -u 2 src/styles/options.css dist/styles",
    "build:styles": "run-p build:styles:content build:styles:live-chat build:styles:options",
    "build:scripts:rollup": "rollup -c",
    "build:scripts:sourcemaps:inject": "sentry-cli sourcemaps inject ./dist/scripts --release=2.38.17",
    "build:scripts:sourcemaps:copy": "node sourcemaps-copy.js",
    "build:scripts:sourcemaps": "run-s build:scripts:sourcemaps:inject build:scripts:sourcemaps:copy",
    "build:scripts": "run-s build:scripts:rollup build:scripts:sourcemaps",
    "build": "node tools/build-full.mjs dist",
    "build:full": "node tools/build-full.mjs",
    "build:basic": "node tools/build-bilibili.mjs",
    "test": "node --test tests/*.test.mjs",
    "lint": "eslint src/bilibili",
    "demo": "node tools/demo-server.mjs",
    "demo:full": "node tools/full-demo-server.mjs",
    "build:youtube": "run-s build:scripts build:styles build:manifest build:html build:images",
    "upload-sourcemaps": "dotenvx run -f .env -f .env.local --overload -- sentry-cli sourcemaps upload ./sourcemaps --release=2.38.17"
  },
  "engines": {
    "node": ">=22.5.1"
  },
  "volta": {
    "node": "22.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.21.8",
    "@babel/parser": "7.27.5",
    "@babel/plugin-proposal-class-properties": "^7.18.6",
    "@babel/plugin-proposal-optional-chaining": "^7.21.0",
    "@dotenvx/dotenvx": "^1.45.1",
    "@rollup/plugin-babel": "^6.0.4",
    "@rollup/plugin-eslint": "^9.0.5",
    "@rollup/plugin-node-resolve": "^16.0.1",
    "@sentry/browser": "^9.27.0",
    "@sentry/cli": "^2.46.0",
    "babel-plugin-transform-replace-expressions": "^0.2.0",
    "copyfiles": "^2.4.1",
    "eslint": "^9.28.0",
    "globals": "^16.2.0",
    "jsdom": "^30.1.1",
    "npm-run-all": "^4.1.5",
    "replace-in-file": "^8.3.0",
    "rollup": "^4.42.0",
    "sass": "^1.62.1"
  },
  "overrides": {
    "@rollup/plugin-eslint": {
      "eslint": "$eslint"
    }
  }
}
